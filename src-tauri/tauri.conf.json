{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiri",
  "version": "0.3.0",
  "identifier": "org.bobpark.kiri",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe", "binaries/kiri-cli"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCMTQ3ODdDM0IwMjdEMTcKUldRWGZRSTdmSGdVRzhZU3Y4Sm92WjRXY1JXT0VWNkl2dlNPdG5zRnVJd0VHazNNOWhnUDBBa0EK",
      "endpoints": ["https://github.com/bob-park/kiri-app/releases/latest/download/latest.json"]
    }
  }
}
